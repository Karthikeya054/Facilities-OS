# Copy to .env and fill in. Placeholders only — never commit real values.

# App
PUBLIC_BASE_URL=http://localhost:5173

# Supabase
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Gemini
GEMINI_API_KEY=your-gemini-api-key

# SMTP (approval + notification emails)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=someone@example.com
SMTP_PASS=your-smtp-password
SMTP_FROM=someone@example.com

# Approval chain
L1_APPROVER_EMAIL=l1-approver@example.com
L1_APPROVER_NAME="L1 Approver"
L2_APPROVER_EMAILS=l2-approver-a@example.com,l2-approver-b@example.com
L2_APPROVER_NAME="L2 Approvers"
EXECUTOR_EMAIL=procurement@example.com
VENDOR_CC_EMAIL=facilities@example.com

# Secrets (generate with: openssl rand -hex 32)
APPROVAL_LINK_SECRET=change-me
REMINDERS_SECRET=change-me

# UniConnect integration
UNICONNECT_WEBHOOK_URL=https://uniconnect.example.com/api/webhooks/facilities
WEBHOOK_SECRET=change-me
